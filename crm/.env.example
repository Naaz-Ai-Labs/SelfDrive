# Copy this file to .env (or .env.local) and fill in real values.
# .env / .env.local are already gitignored — never commit real keys.

# Razorpay (https://dashboard.razorpay.com/app/keys) — test-mode keys are fine to start.
# Without these set, the booking flow falls back to "pay at pickup" and no online
# checkout is offered — the app runs fine either way.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shared secret between this CRM (the gateway owner) and the public web app.
# Must match GATEWAY_API_KEY in web/.env — generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_API_KEY=

# Supabase Credentials
SUPABASE_URL=https://kqswqwblnuzftwtpqwdk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://kqswqwblnuzftwtpqwdk.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
