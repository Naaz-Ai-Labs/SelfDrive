# Copy this file to .env (or .env.local) and fill in real values.
# .env / .env.local are already gitignored — never commit real keys.

# Where the CRM (API gateway + database owner) is reachable from this app's server.
# In production this points at the CRM's private origin — never expose it to the browser.
CRM_API_URL=http://localhost:3001

# Shared secret between this web app and the CRM gateway — must match GATEWAY_API_KEY
# in crm/.env. This proves a gateway request came from this server, never the browser.
GATEWAY_API_KEY=
